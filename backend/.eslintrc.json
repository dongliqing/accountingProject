{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "env": {
    "node": true,
    "es2020": true
  },
  "rules": {
    "quotes": "off",
    "@typescript-eslint/quotes": "off",
    "semi": "off",
    "@typescript-eslint/semi": "off"
  }
}
