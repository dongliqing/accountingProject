{
  "root": true,
  "extends": [
    "plugin:vue/vue3-recommended"
  ],
  "parser": "vue-eslint-parser",
  "parserOptions": {
    "parser": "@typescript-eslint/parser",
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "rules": {
    "quotes": "off",
    "@typescript-eslint/quotes": "off",
    "semi": "off",
    "@typescript-eslint/semi": "off",
    "vue/html-self-closing": "off"
  }
}
